import { describe, it, expect, beforeEach, vi } from "vitest";
const { Storage, DedupStore } = require("../src/storage");
const { Utils } = require("../src/utils");

// 探针:四类去重链路行为验证
describe("PROBE: 四类去重链路", () => {
  beforeEach(() => {
    Storage._exportedTopicsCache = null;
    vi.clearAllMocks();
  });

  it("P1 Linux.do 去重:isTopicExported 与 markTopicExported 键对称", () => {
    Storage.markTopicExported(12345);           // number
    expect(Storage.isTopicExported(12345)).toBe(true);
    expect(Storage.isTopicExported("12345")).toBe(true); // string 应等价
    // getBookmarkKey 返回 String(topic_id),检查 String 包装一致性
    expect(Storage.isTopicExported(String(12345))).toBe(true);
  });

  it("P2 双轨:Storage.EXPORTED_TOPICS 与 DedupStore linuxdo 集合隔离", () => {
    Storage.markTopicExported(111);
    DedupStore.markSeen("linuxdo", "linuxdo:111");
    // UI/手动/AutoImporter 走 Storage
    expect(Storage.isTopicExported(111)).toBe(true);
    // SyncCoordinator 走 DedupStore
    expect(DedupStore.isDuplicate("linuxdo", "linuxdo:111")).toBe(true);
    // 但两边互不知道对方的记录:
    expect(DedupStore.isDuplicate("linuxdo", "linuxdo:111")).toBe(true);
    expect(Storage.isTopicExported(222)).toBe(false);
    DedupStore.markSeen("linuxdo", "linuxdo:222");
    expect(DedupStore.isDuplicate("linuxdo", "linuxdo:222")).toBe(true);
    expect(Storage.isTopicExported(222)).toBe(false); // ← Storage 不知道
  });

  it("P3 分类列表去重 parseAICategories 大小写", () => {
    const cats = Utils.parseAICategories("AI, ai, 前端, 前端, 后端");
    expect(cats).toEqual(["AI", "ai", "前端", "后端"]); // 精确去重,大小写不同视为不同
  });

  it("P4 书签去重:BookmarkExporter url 键 vs Adapter id 键", () => {
    // BookmarkExporter 用 url 作键
    const { BookmarkExporter } = require("../src/bridge");
    BookmarkExporter.markExportedAndFlush("https://a.com");
    expect(BookmarkExporter.isExported("https://a.com")).toBe(true);
    // BookmarkAdapter 用 item.id 作键(SyncCoordinator 路径)
    const { BookmarkAdapter } = require("../src/adapter/BookmarkAdapter");
    const key = BookmarkAdapter.getDedupKey({ id: "https://a.com" });
    expect(key).toBe("bookmark:https://a.com");
    // DedupStore 里没有该记录 → 双轨:书签自动同步(BookmarkExporter.isExported)与
    // SyncCoordinator(RSS 用)路径不一致
  });
});
